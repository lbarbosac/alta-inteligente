DATABASE_URL=""
JWT_SECRET=""
PORT=3000
FRONTEND_URL="http://localhost:5173"
TZ="America/Sao_Paulo"

# Atrás de proxy reverso (Nginx, Render, Railway…): quantos proxies confiar. Vazio em desenvolvimento.
TRUST_PROXY=""

# Pasta das fotos dos check-ins (fora do código e do git). Vazio = backend/storage
STORAGE_DIR=""

# E-mail — alertas de dor e recuperação de senha.
# Sem SMTP_HOST, os e-mails são simulados e aparecem no log do servidor.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="AltaInteligente <nao-responda@seudominio.com.br>"

# WhatsApp Cloud API (Meta) — lembrete diário do paciente.
# Sem WHATSAPP_TOKEN, os lembretes são simulados e aparecem no log do servidor.
# O modelo precisa estar aprovado na Meta, em português, com 3 variáveis no corpo:
#   {{1}} primeiro nome · {{2}} dia da recuperação · {{3}} link do check-in
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_TEMPLATE_LEMBRETE="lembrete_checkin"
WHATSAPP_TEMPLATE_IDIOMA="pt_BR"
LEMBRETES_ATIVOS=true
